+    while i < n:
+        ch = text[i]
+        if ch in "\"'":
+            j, body = i + 1, []
+            while j < n and text[j] != ch:
+                if text[j] == "\\" and j + 1 < n:
+                    nxt = text[j + 1]
+                    if nxt == "u":
+                        digits = re.match(r"[0-9a-fA-F]{0,4}", text[j + 2:j + 6]).group()
+                        if digits:
+                            body.append("\\u" + digits.zfill(4))
+                        j += 2 + len(digits)
+                    elif nxt in _JSON_ESCAPES:
+                        body.append(text[j:j + 2])
+                        j += 2
+                    else:  # \' or an unknown escape: keep the character only
+                        body.append('\\"' if nxt == '"' else nxt)
+                        j += 2
+                    continue
+                body.append('\\"' if text[j] == '"' else text[j])
+                j += 1
+            out.append('"' + "".join(body) + '"')
+            i = j + 1
+            tag = _LITERAL_TAG.match(text, i)
+            if tag:
+                i = tag.end()
+        elif text.startswith("//", i) or ch == "#":
+            end = text.find("\n", i)
+            i = n if end < 0 else end
+        elif ch == ",":
+            if not re.match(r",\s*[\]}]", text[i:]):

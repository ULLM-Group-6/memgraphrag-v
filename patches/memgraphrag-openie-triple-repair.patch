+def _clean_triple(triple):
+    """Return (triple, None) for a usable triple, (None, reason) otherwise.
+    Numbers become strings; extra elements are qualifiers of the object
+    (["A", "played for", "B", "in", "2008"] -> ["A", "played for", "B in 2008"])."""
+    if isinstance(triple, dict):
+        triple = [triple.get(k) for k in ("subject", "relation" if "relation" in triple else "predicate", "object")]
+    if not isinstance(triple, list):
+        return None, "not a list"
+    if any(item is None for item in triple):
+        return None, "null element"
+    if any(isinstance(item, (bool, dict, list)) for item in triple):
+        return None, "boolean or nested element"
+    items = [str(item).strip() for item in triple]
+    if any(not item for item in items):
+        return None, "empty element"
+    if len(items) < 3:
+        return None, f"{len(items)} elements"
+    return [items[0], items[1], " ".join(items[2:])], None

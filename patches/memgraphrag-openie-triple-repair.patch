+def _to_strict_json(text):
+    """Rewrite the near-JSON Qwen emits into strict JSON: // comments,
+    Python None/True/False, single-quoted strings, RDF datatype tags, invalid
+    or short \\u escapes and trailing commas. Content inside strings is kept."""
